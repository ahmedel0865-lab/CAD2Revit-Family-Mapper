<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build one Revit version at a time:
      dotnet build -c Release -p:RevitVersion=2024
    Revit 2022-2024 run on .NET Framework 4.8; Revit 2025+ run on .NET 8.
    The Revit API reference assemblies come from the Nice3point.Revit.Api NuGet
    packages, so Revit does not need to be installed to compile.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025">net8.0-windows</TargetFramework>
    <AssemblyName>CAD2Revit</AssemblyName>
    <RootNamespace>CAD2Revit</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2023">$(DefineConstants);REVIT2023_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2024">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- WinForms (dialogs) + WPF imaging (ribbon icons). Referenced directly rather
       than with UseWindowsForms/UseWPF so the project also builds with .NET SDKs
       that do not ship the Windows Desktop SDK (e.g. Linux CI). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!-- Compile the Revit-free core straight into this DLL: one file to deploy. -->
  <ItemGroup>
    <Compile Include="..\CAD2Revit.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>
</Project>
