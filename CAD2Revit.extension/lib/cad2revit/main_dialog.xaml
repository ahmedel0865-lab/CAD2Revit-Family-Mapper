<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD2Revit - Place Families" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="DWG link / import" VerticalAlignment="Center"/>
        <ComboBox x:Name="dwg_cb" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                  DisplayMemberPath="name"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mapping file" VerticalAlignment="Center"/>
        <TextBox x:Name="map_tb" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center"
                 ToolTip="CSV or XLSX mapping table"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="6,4,0,4" Padding="10,2"
                Click="browse_click"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target level" VerticalAlignment="Center"/>
        <ComboBox x:Name="level_cb" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                  DisplayMemberPath="name"/>

        <CheckBox x:Name="nested_cb" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6"
                  Content="Include blocks nested inside other blocks"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6" TextWrapping="Wrap"
                   Foreground="Gray"
                   Text="Preview runs the full placement and then undoes it, so the counts match a real run. Run places everything in one transaction (one Ctrl+Z)."/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Preview" Width="90" Margin="0,0,8,0" Click="preview_click" IsDefault="True"/>
            <Button Content="Run" Width="90" Margin="0,0,8,0" Click="run_click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
